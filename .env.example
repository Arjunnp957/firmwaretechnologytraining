# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# Variables must start with VITE_ to be available in the browser.
# Never commit the real .env file (it is listed in .gitignore).

# Web3Forms access key (free): https://web3forms.com
# Note: Web3Forms keys are designed to be public in frontend code, but keep
# it in the environment so it is easy to rotate and is not committed.
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here